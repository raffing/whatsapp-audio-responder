{
  "name": "whatsapp-audio-responder-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@whatsapp-audio/web",
    "build:web": "npm run build --workspace=@whatsapp-audio/web",
    "dev:mobile": "npm run start --workspace=@whatsapp-audio/mobile",
    "build:mobile": "npm run build:android --workspace=@whatsapp-audio/mobile"
  },
  "devDependencies": {
    "typescript": "~5.8.2"
  }
}
